@model _25dh110213_BE_LTW.Models.Product

@* CỐ ĐỊNH: Di chuyển CSS ra ngoài, thêm định dạng form-control cho textarea *@
<style>
    textarea.form-control {
        width: 100%;
        height: 150px;
        padding: 12px 20px;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 4px;
        background-color: #f8f8f8;
        resize: none;
    }
</style>

@* 1. Trường Danh mục *@
<div class="form-group clearfix">
    @Html.LabelFor(model => model.CategoryID, "Danh mục", new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.DropDownList("CategoryID", null, htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger" })
    </div>
</div>

@* 2. Trường Tên sản phẩm *@
<div class="form-group clearfix">
    @Html.LabelFor(model => model.ProductName, "Tên sản phẩm", new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
    </div>
</div>

@* 3. Trường Mô tả *@
<div class="form-group clearfix">
    @Html.LabelFor(model => model.ProductDescription, "Mô tả", new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.TextAreaFor(model => model.ProductDescription, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.ProductDescription, "", new { @class = "text-danger" })
    </div>
</div>

@* 4. ĐÃ FIX: Chặn đơn giá tối đa 100 triệu (100000000) và thêm chữ ghi mờ placeholder gợi ý *@
<div class="form-group clearfix">
    @Html.LabelFor(model => model.ProductPrice, "Đơn giá", new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.TextBoxFor(model => model.ProductPrice, "{0:0}", new { @class = "form-control", type = "number", step = "1", min = "0", max = "100000000", placeholder = "Tối đa 100.000.000 đ" })
        @Html.ValidationMessageFor(model => model.ProductPrice, "", new { @class = "text-danger" })
    </div>
</div>

@* 5. Trường Hình ảnh *@
<div class="form-group clearfix">
    @Html.LabelFor(model => model.ProductImage, "Hình ảnh", new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        <input type="file" name="UploadImg" class="form-control" />
        @Html.ValidationMessageFor(model => model.ProductImage, "", new { @class = "text-danger" })
    </div>
</div>

@* 6. ĐÃ FIX: Siết số lượng tồn tối đa 1.000 (1000) và thêm chữ ghi mờ placeholder gợi ý *@
<div class="form-group clearfix">
    @Html.LabelFor(model => model.Quantity, "Số lượng tồn", new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", max = "1000", placeholder = "Tối đa 1.000 cái" } })
        @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
    </div>
</div>
