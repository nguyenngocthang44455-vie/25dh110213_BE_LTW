@model _25dh110213_BE_LTW.Models.ViewModel.ProfileVM

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container" style="margin-top: 30px; margin-bottom: 50px;">
    <div class="row">
        <h2 style="font-weight: bold; color: #333; font-family: 'Times New Roman', Times, serif; letter-spacing: 1px;">THÔNG TIN TÀI KHOẢN</h2>
        <hr />

        @* Hiển thị thông báo thành công / lỗi từ Controller *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()

            <!-- Hiển thị tên tài khoản (Khóa - Không cho sửa) -->
            <div class="form-group">
                <label class="control-label col-md-2" style="font-size: 14px;">Tên đăng nhập:</label>
                <div class="col-md-6">
                    <input type="text" class="form-control" value="@Model.Username" disabled style="background-color: #f9f9f9; border-radius: 0;" />
                    <input type="hidden" name="Username" value="@Model.Username" />
                </div>
            </div>

            <!-- Họ tên -->
            <div class="form-group">
                <label class="control-label col-md-2" style="font-size: 14px;">Họ tên:</label>
                <div class="col-md-6">
                    <input type="text" name="CustomerName" class="form-control" value="@Model.CustomerName" required style="border-radius: 0;" />
                    @Html.ValidationMessage("CustomerName", "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Số điện thoại giới hạn tối đa 10 số và chặn nhập chữ -->
            <div class="form-group">
                <label class="control-label col-md-2" style="font-size: 14px;">Số điện thoại:</label>
                <div class="col-md-6">
                    @{
                        var phoneVal = (Model.CustomerPhone == "Đang cập nhật") ? "" : Model.CustomerPhone;
                    }
                    <input type="tel" name="CustomerPhone" class="form-control" value="@phoneVal" placeholder="Nhập số điện thoại (10 số)" required maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '')" style="border-radius: 0;" />
                    @Html.ValidationMessage("CustomerPhone", "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label class="control-label col-md-2" style="font-size: 14px;">Email:</label>
                <div class="col-md-6">
                    <input type="email" name="CustomerEmail" class="form-control" value="@Model.CustomerEmail" required style="border-radius: 0;" />
                    @Html.ValidationMessage("CustomerEmail", "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Địa chỉ -->
            <div class="form-group">
                <label class="control-label col-md-2" style="font-size: 14px;">Địa chỉ:</label>
                <div class="col-md-6">
                    <input type="text" name="CustomerAddress" class="form-control" value="@Model.CustomerAddress" required style="border-radius: 0;" />
                    @Html.ValidationMessage("CustomerAddress", "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Nút lưu thay đổi -->
            <div class="form-group" style="margin-top: 25px;">
                <div class="col-md-offset-2 col-md-6">
                    <button type="submit" class="btn btn-dark" style="background-color: #000; color: #fff; border-radius: 0; padding: 10px 25px; font-weight: bold; text-transform: uppercase; font-size: 12px; letter-spacing: 1px; border: none;">Lưu thay đổi</button>
                </div>
            </div>
        }

        <hr style="margin-top: 40px; margin-bottom: 30px;" />

        <h3 style="font-weight: bold; color: #333; font-family: 'Times New Roman', Times, serif; letter-spacing: 1px;">ĐỔI MẬT KHẨU</h3>
        <br />

        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="control-label col-md-2" style="font-size: 14px;">Mật khẩu cũ:</label>
                <div class="col-md-6">
                    <input type="password" name="oldPassword" class="form-control" required style="border-radius: 0;" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2" style="font-size: 14px;">Mật khẩu mới:</label>
                <div class="col-md-6">
                    <input type="password" name="newPassword" class="form-control" required style="border-radius: 0;" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2" style="font-size: 14px;">Xác nhận mật khẩu:</label>
                <div class="col-md-6">
                    <input type="password" name="confirmNewPassword" class="form-control" required style="border-radius: 0;" />
                </div>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <div class="col-md-offset-2 col-md-6">
                    <button type="submit" class="btn btn-dark" style="background-color: #333; color: #fff; border-radius: 0; padding: 10px 25px; font-weight: bold; text-transform: uppercase; font-size: 12px; letter-spacing: 1px; border: none;">Cập nhật mật khẩu</button>
                </div>
            </div>
        }
    </div>
</div>
