@model _25dh110213_BE_LTW.Models.ViewModel.ProfileVM

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 30px;">
    <div class="row">
        <h2>Thông tin tài khoản</h2>
        <hr />

        @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()

            <!-- Hiển thị tên tài khoản (Khóa - Không cho sửa) -->
            <div class="form-group">
                <label class="control-label col-md-2">Tên đăng nhập:</label>
                <div class="col-md-6">
                    <input type="text" class="form-control" value="@Model.Username" disabled />
                </div>
            </div>

            <!-- Họ tên -->
            <div class="form-group">
                <label class="control-label col-md-2">Họ tên:</label>
                <div class="col-md-6">
                    <input type="text" name="CustomerName" class="form-control" value="@Model.CustomerName" required />
                    @Html.ValidationMessage("CustomerName", "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Số điện thoại -->
            <div class="form-group">
                <label class="control-label col-md-2">Số điện thoại:</label>
                <div class="col-md-6">
                    <input type="tel" name="CustomerPhone" class="form-control" value="@Model.CustomerPhone" required />
                    @Html.ValidationMessage("CustomerPhone", "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label class="control-label col-md-2">Email:</label>
                <div class="col-md-6">
                    <input type="email" name="CustomerEmail" class="form-control" value="@Model.CustomerEmail" required />
                    @Html.ValidationMessage("CustomerEmail", "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Địa chỉ -->
            <div class="form-group">
                <label class="control-label col-md-2">Địa chỉ:</label>
                <div class="col-md-6">
                    <input type="text" name="CustomerAddress" class="form-control" value="@Model.CustomerAddress" required />
                    @Html.ValidationMessage("CustomerAddress", "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Nút lưu thay đổi -->
            <div class="form-group">
                <div class="col-md-offset-2 col-md-6">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </div>
        }
    </div>
</div>
