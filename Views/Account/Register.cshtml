@model _25dh110213_BE_LTW.Models.ViewModel.RegisterVM
@{
    ViewBag.Title = "Đăng ký tài khoản";
    // Tự động kiểm tra nếu có file _CustomerLayout.cshtml thì dùng, nếu không thì dùng _Layout.cshtml mặc định
    Layout = File.Exists(Server.MapPath("~/Views/Shared/_CustomerLayout.cshtml")) ? "~/Views/Shared/_CustomerLayout.cshtml" : "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 40px; margin-bottom: 40px; max-width: 600px;">
    <h2 class="text-center" style="font-weight: bold; color: #333; margin-bottom: 30px;">ĐĂNG KÝ TÀI KHOẢN</h2>

    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
    {
    @Html.AntiForgeryToken()

    <div class="well" style="background-color: #fff; border-radius: 8px; padding: 25px; border: 1px solid #e5e5e5;">
        <h4>Thông tin tài khoản</h4>
        <hr style="margin-top: 5px; margin-bottom: 20px;" />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Tên đăng nhập -->
        <div class="form-group">
            @Html.LabelFor(m => m.Username, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Mật khẩu -->
        <div class="form-group">
            @Html.LabelFor(m => m.Password, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Xác nhận mật khẩu -->
        <div class="form-group">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>
        </div>

        <h4 style="margin-top: 30px;">Thông tin khách hàng</h4>
        <hr style="margin-top: 5px; margin-bottom: 20px;" />

        <!-- Họ tên -->
        <div class="form-group">
            @Html.LabelFor(m => m.CustomerName, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Số điện thoại -->
        <div class="form-group">
            @Html.LabelFor(m => m.CustomerPhone, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Email -->
        <div class="form-group">
            @Html.LabelFor(m => m.CustomerEmail, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Địa chỉ -->
        <div class="form-group">
            @Html.LabelFor(m => m.CustomerAddress, new { @class = "col-md-3 control-label" })
            <div class="col-md-9">
                @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Nút bấm Đăng ký -->
        <div class="form-group" style="margin-top: 25px; margin-bottom: 0;">
            <div class="col-md-offset-3 col-md-9">
                <input type="submit" class="btn btn-info btn-block" value="Đăng ký" style="background-color: #4dbdd6; font-weight: bold; font-size: 16px; padding: 10px; border: none;" />
            </div>
        </div>
    </div>

    <p class="text-center" style="margin-top: 15px; font-size: 14px;">Bạn Đã Có Tài Khoản? <a href="@Url.Action("Login", "Account")" style="color: #0b74e5; font-weight: bold; text-decoration: none;">Đăng nhập</a></p>
    }
</div>
