<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cloudflare.com" />
    <style>
        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            color: #232324;
            margin: 0;
        }

        .top-banner-freeship {
            background: #f7f7f7;
            text-align: center;
            padding: 8px 0;
            font-size: 12px;
            border-bottom: 1px solid #ebebeb;
        }

        .store-top-header {
            padding: 15px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        /* THANH NAV ĐEN */
        .store-navigation-bar {
            background: #000;
            padding: 10px 0;
        }

        .nav-flex-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-left-group {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        /* ĐỊNH DẠNG NÚT BẤM - ÉP MÀU CHỮ KHI HOVER KHÔNG BỊ MẤT */
        .custom-nav-btn {
            background: transparent;
            color: #fff !important;
            border: 1px solid #fff;
            padding: 10px 22px;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            text-decoration: none !important;
            cursor: pointer;
            display: inline-block;
        }

            .custom-nav-btn:hover {
                background: #fff !important;
                color: #000 !important;
                text-decoration: none !important;
            }

        .btn-admin-panel {
            border-color: #ff4d4d;
            color: #ff4d4d !important;
        }

            .btn-admin-panel:hover {
                background: #ff4d4d !important;
                color: #fff !important;
            }

        /* MENU 3 GẠCH DROPDOWN */
        .hamburger-dropdown {
            position: relative;
            display: inline-block;
        }

        .hamburger-content {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #fff;
            min-width: 220px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.15);
            z-index: 1000;
            border: 1px solid #ebebeb;
            margin-top: 6px;
        }

            /* TRIỆT TIÊU TOÀN BỘ DẤU CHẤM TRÒN VÀ LỀ THỪA CỦA PARTIAL VIEW */
            .hamburger-content ul, .hamburger-content li {
                padding: 0 !important;
                margin: 0 !important;
                list-style: none !important;
                list-style-type: none !important;
            }

                .hamburger-content a, .hamburger-content li a, .hamburger-content ul li a {
                    display: block !important;
                    padding: 12px 20px !important;
                    color: #232324 !important;
                    text-decoration: none !important;
                    font-size: 14px !important;
                    border-bottom: 1px solid #f5f5f5 !important;
                    text-align: left !important;
                }

                    .hamburger-content a:hover, .hamburger-content li a:hover, .hamburger-content ul li a:hover {
                        background: #f7f7f7 !important;
                        color: #0b74e5 !important;
                        text-decoration: none !important;
                    }

        /* DROPDOWN TÀI KHOẢN */
        .dropdown-account {
            position: relative;
        }

            .dropdown-account:hover .dropdown-account-content {
                display: block;
            }

        .dropdown-account-content {
            display: none;
            position: absolute;
            top: 100%;
            right: 0;
            background: #fff;
            min-width: 180px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
            z-index: 1000;
            border: 1px solid #ebebeb;
        }

            .dropdown-account-content a {
                display: block;
                padding: 12px 15px;
                color: #232324 !important;
                text-decoration: none !important;
                font-size: 13px;
                text-align: left;
            }

                .dropdown-account-content a:hover {
                    background: #f7f7f7;
                    color: #000 !important;
                    text-decoration: none !important;
                }
    </style>
</head>
<body>
    @{
        var cart = Session["Cart"] as _25dh110213_BE_LTW.Models.ViewModel.Cart;
        int cartCount = (cart != null && cart.Items != null) ? cart.Items.Sum(i => i.Quantity) : 0;
    }
    <div class="top-banner-freeship">FREE SHIPPING ON ALL ORDERS. NO MINIMUM PURCHASE.</div>

    <div class="store-top-header">
        <div class="container text-right">
            <a href="@Url.Action("Index", "Cart")" style="font-weight: bold; color: #000; text-decoration: none;">
                <i class="fas fa-shopping-bag"></i> Giỏ hàng (@cartCount)
            </a>
        </div>
    </div>

    <nav class="store-navigation-bar">
        <div class="container">
            <div class="nav-flex-container">
                <div class="nav-left-group">
                    <div class="hamburger-dropdown">
                        <button type="button" id="btn-hamburger-toggle" class="custom-nav-btn" style="background: #222; border-color: #444;"><i class="fas fa-bars"></i> Danh mục sản phẩm</button>
                        <div class="hamburger-content" id="dropdown-categories-box">@Html.Action("CategoryMenu", "Home")</div>
                    </div>
                    <a href="@Url.Action("Index", "Home")" class="custom-nav-btn">Trang chủ</a>
                    @if (User.Identity.IsAuthenticated && User.Identity.Name.ToLower() == "admin")
                    {
                        <a href="@Url.Action("Index", "AD", new { area = "Admin" })" class="custom-nav-btn btn-admin-panel"><i class="fas fa-lock"></i> Quản trị</a>
                    }
                </div>
                <div class="dropdown-account">
                    <button type="button" class="custom-nav-btn">Tài khoản <i class="fas fa-chevron-down" style="font-size: 10px;"></i></button>
                    <div class="dropdown-account-content">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a href="javascript:void(0)" style="font-weight: bold; color: #0b74e5 !important; border-bottom: 1px solid #ebebeb;">Hi, @User.Identity.Name</a>
                            <a href="@Url.Action("ProfileInfo", "Account")">Thông tin tài khoản</a>
                            <a href="@Url.Action("MyOrder", "Order")">Đơn hàng của tôi</a>
                            <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Register", "Account")">Đăng ký tài khoản</a>
                            <a href="@Url.Action("Login", "Account")">Đăng nhập tài khoản</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <div class="container body-content" style="min-height: 500px; margin-top: 25px;">@RenderBody()</div>
    <footer style="background: #ffffff; padding: 30px 0; margin-top: 50px; border-top: 1px solid #ebebeb; color: #666; font-size: 13px;">
        <div class="container">
            <div class="row">
                <div class="col-md-6"><p>&copy; @DateTime.Now.Year - Đồ án Web Bán Hàng.</p></div>
                <div class="col-md-6 text-right"><p><strong>Thành viên nhóm:</strong> Nguyễn Ngọc Thắng (25dh110213)</p></div>
            </div>
        </div>
    </footer>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        $(document).ready(function () {
            $('#btn-hamburger-toggle').click(function (e) { e.stopPropagation(); $('#dropdown-categories-box').slideToggle(200); });
            $(document).click(function (e) { if (!$(e.target).closest('.hamburger-dropdown').length) { $('#dropdown-categories-box').slideUp(150); } });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
