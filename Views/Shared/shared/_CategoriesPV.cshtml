@model IEnumerable<_25dh110213_BE_LTW.Models.Category>

<li class="dropdown">
    <a href="javascript:void(0)" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
        <i class="fas fa-list"></i> Danh mục sản phẩm <span class="caret"></span>
    </a>
    <ul class="dropdown-content" style="min-width: 200px;">
        @foreach (var cat in Model)
        {
        <li>
            <!-- Link dẫn tới trang hiển thị danh sách sản phẩm theo mã danh mục cụ thể -->
            <a href="@Url.Action("ProductList", "Home", new { id = cat.CategoryID })">
                @cat.CategoryName
            </a>
        </li>
        }
    </ul>
</li>

