@model _25dh110213_BE_LTW.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc;

@* Nhúng file style chung của trang chủ khách hàng để tái sử dụng giao diện lưới *@
<link href="~/Content/myStyle/CustomerHome.css" rel="stylesheet" type="text/css" />

@* Kiểm tra danh sách sản phẩm bán chạy có dữ liệu hay không *@
@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    <section class="feature-product">
        <div class="container-fluid feature-pro">
            <h2 class="product-title" style="font-weight: bold;">Sản phẩm bán chạy cùng danh mục</h2>
            <ul class="product-list">
                @foreach (var product in Model.TopProducts)
                {
                    <li class="product-item">
                        @* Đường dẫn chuyển sang trang xem chi tiết của sản phẩm được chọn *@
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img class="product-image" src="@Url.Content(product.ProductImage)" alt="@product.ProductName" />
                            <div class="prod-name">@Html.DisplayFor(modelItem => product.ProductName)</div>
                            <div class="prod-price">@product.ProductPrice.ToString("N0") đ</div>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <!-- Khối hiển thị phân trang dành riêng cho danh sách sản phẩm bán chạy -->
        <div class="pagination-container">
            <div class="pagination-links">
                @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetails", "Home",
                         new
                         {
                             id = Model.product.ProductID,
                             quantity = Model.quantity,
                             page = page
                         }))
            </div>
        </div>
    </section>
}
