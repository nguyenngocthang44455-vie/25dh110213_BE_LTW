@model _25dh110213_BE_LTW.Models.ViewModel.HomeProductVM
<div class="feature-product">
    <h2 class="product-title">SẢN PHẨM NỔI BẬT</h2>

    <ul class="product-list">
        @foreach (var item in Model.FeaturedProducts)
        {
            <li class="product-item">
                <a href="@Url.Action("Details", "Products", new { id = item.ProductID })">
                    <img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" class="product-image" />
                    <div class="prod-name">@item.ProductName</div>
                    <div class="prod-price">@string.Format("{0:N0} đ", item.ProductPrice)</div>
                </a>
            </li>
        }
    </ul>
</div>


