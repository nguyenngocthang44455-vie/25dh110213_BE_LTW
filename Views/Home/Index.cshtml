@model _25dh110213_BE_LTW.Models.ViewModel.HomeProductVM
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
<style>
    .store-intro-banner {
        background-color: #1e3b2b;
        background-size: cover;
        background-position: center;
        padding: 90px 8%;
        margin-bottom: 40px;
        position: relative;
        border-radius: 4px;
        overflow: hidden;
    }

        .store-intro-banner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.35);
            z-index: 1;
        }

    .store-intro-text {
        position: relative;
        z-index: 2;
        max-width: 650px;
        color: #fff;
    }

        .store-intro-text h3 {
            font-size: 14px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #e8e8e8;
            margin-bottom: 10px;
        }

        .store-intro-text h2 {
            font-size: 40px;
            font-weight: bold;
            margin-top: 0;
            margin-bottom: 15px;
        }

        .store-intro-text p {
            font-size: 15px;
            line-height: 1.7;
            color: #f5f5f5;
        }

    .section-title-store {
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        margin: 40px 0 35px 0;
        text-transform: uppercase;
    }

    .product-grid-store {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 30px;
        margin-bottom: 50px;
    }

    .product-link-store {
        text-decoration: none !important;
        display: block;
        color: inherit !important;
        text-align: center;
    }

    .product-card-store img {
        width: 100%;
        height: 280px;
        object-fit: cover;
        margin-bottom: 15px;
        border: 1px solid #f2f2f2;
    }
</style>

<div class="store-intro-banner" style="background-image: url('@Url.Content("~/Content/images/banner.png")');">
    <div class="store-intro-text">
        <h3>CHÀO MỪNG BẠN ĐẾN VỚI CHÚNG TÔI</h3>
        <h2>GIỚI THIỆU CỬA HÀNG</h2>
        <p>Cửa hàng chuyên cung cấp các sản phẩm chính hãng đa dạng danh mục với chất lượng dịch vụ hàng đầu. Cam kết mang lại trải nghiệm mua sắm an tâm và tiện lợi nhất cho quý khách hàng.</p>
    </div>
</div>

<div class="container" style="margin-bottom: 40px; max-width: 600px;">
    @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { @class = "form-inline" }))
    {
        <div class="input-group" style="width: 100%;">
            <input type="text" name="searchTerm" class="form-control" placeholder="Nhập tên sản phẩm cần tìm..." style="border-radius:0; padding:20px 15px;" />
            <span class="input-group-btn"><button class="btn btn-dark" type="submit" style="background:#000; color:#fff; border-radius:0; padding:10px 22px; border:none;">TÌM KIẾM</button></span>
        </div>
    }
</div>

<div class="container">
    <h2 class="section-title-store">CÁC SẢN PHẨM</h2>
    <div class="product-grid-store">
        @foreach (var item in Model.FeaturedProducts)
        {
            <div class="product-card-store">
                <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })" class="product-link-store">
                    <img src="@item.ProductImage" alt="@item.ProductName" />
                    <h4 style="font-size:14px; margin-bottom:8px;">@item.ProductName</h4>
                    <strong style="font-size:15px; color:#000;">@item.ProductPrice.ToString("N0") đ</strong>
                </a>
            </div>
        }
    </div>
</div>
